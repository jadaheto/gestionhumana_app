# Entorno: development | test | production
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gestion_humana
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false
# Aplicar migraciones pendientes al arrancar (recomendado en despliegues): true | false
DB_MIGRATIONS_RUN=false
# synchronize de TypeORM (crea/altera tablas desde las entidades). SOLO desarrollo; en producción se ignora.
DB_SYNCHRONIZE=false

# --- JWT ---
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=8h

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=noreply@comfasucre.com.co
MAIL_FROM_NAME=Comfasucre Admin

# --- Comunicados por correo (test | produccion) ---
COMUNICADOS_MAIL_MODE=test
COMUNICADOS_MAIL_TEST_TO=
COMUNICADOS_MAIL_PROD_TO=

# --- Archivos ---
UPLOADS_DIR=./uploads
# URL pública del frontend (enlaces en correos)
FRONTEND_URL=http://localhost:4200

# --- Ingreso con Google (OAuth 2.0). Único método de ingreso de la web; vacío = no se puede ingresar ---
# Solo entran correos registrados en Usuarios (y con contrato activo, salvo administradores).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir con la URI de redirección autorizada en Google Cloud y llegar al API
GOOGLE_CALLBACK_URL=http://localhost:4200/api/v1/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=comfasucre.com.co
