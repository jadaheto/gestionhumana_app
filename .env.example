# Entorno: development | test | production
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gestion_humana
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false
# Aplicar migraciones pendientes al arrancar (recomendado en despliegues): true | false
DB_MIGRATIONS_RUN=false
# synchronize de TypeORM (crea/altera tablas desde las entidades). SOLO desarrollo; en producción se ignora.
DB_SYNCHRONIZE=false

# --- JWT ---
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=8h

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=noreply@comfasucre.com.co
MAIL_FROM_NAME=Comfasucre Admin

# --- Comunicados por correo (test | produccion) ---
COMUNICADOS_MAIL_MODE=test
COMUNICADOS_MAIL_TEST_TO=
COMUNICADOS_MAIL_PROD_TO=

# --- Archivos ---
UPLOADS_DIR=./uploads
# URL pública del frontend (enlaces en correos)
FRONTEND_URL=http://localhost:4200

# --- Ingreso con Google (OAuth 2.0). Único método de ingreso de la web; vacío = no se puede ingresar ---
# Solo entran correos registrados en Usuarios (y con contrato activo, salvo administradores).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir con la URI de redirección autorizada en Google Cloud y llegar al API
GOOGLE_CALLBACK_URL=http://localhost:4200/api/v1/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=comfasucre.com.co

# --- Asistente IA "Ask AI" (solo administradores; solo lectura sobre la base de datos) ---
# Proveedor compatible con OpenAI (DeepSeek por defecto). Con la clave vacía el asistente responde 503.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=30000

# --- Registro de eventos de seguridad (tools/Seguridad/directrices-logs.md) ---
# Con LOGS_DB_HOST vacío el registro queda apagado y la aplicación funciona igual.
LOGS_DB_HOST=
LOGS_DB_PORT=5432
LOGS_DB_NAME=logs
LOGS_DB_USER=gestion_humana_app
LOGS_DB_PASSWORD=
LOGS_DB_SSL=false

# --- Base de datos del reloj biométrico (asistencia) ---
# Otra base PostgreSQL, de sólo lectura, con la estructura del reporte "Asistencia Diaria":
# Nro. de serie, Departamento, Nro. de usuario, ID de usuario (cédula), Nombre, Fecha/Hora,
# Tipo de registro, Operación, Descripción de la exepción, Turno, Código de identificación,
# Identificación, Código de tarea, Dispositivo Nro., Marcado.
# Los nombres de columna se reconocen con o sin tildes/mayúsculas (`id_de_usuario`, `fecha_hora`, ...).
# Con ASISTENCIA_DB_HOST vacío queda apagada y la asistencia sólo se carga por archivo.
ASISTENCIA_DB_HOST=
ASISTENCIA_DB_PORT=5432
ASISTENCIA_DB_NAME=
ASISTENCIA_DB_USER=
ASISTENCIA_DB_PASSWORD=
ASISTENCIA_DB_SSL=false
ASISTENCIA_DB_SCHEMA=public
# Tabla o vista con las marcaciones y su columna de fecha y hora
ASISTENCIA_DB_TABLE=asistencia_diaria
ASISTENCIA_DB_COLUMNA_FECHA=fecha_hora
ASISTENCIA_DB_TIMEOUT_MS=8000
